# ---------------------------------------------------------------
# Unreal Engine 5 — library_project
# ---------------------------------------------------------------

# Pastas geradas pela engine (recriadas ao abrir o projeto)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Pacote da Fab "Stationer" (~2 GB). Não versionado: a licença da Fab não
# permite redistribuir os assets, e o tamanho estoura a cota de LFS.
# Para restaurar numa máquina nova, veja docs/SETUP.md.
/Content/Stationer/

# Outros pacotes da Fab usados como fonte de props (mesma razão: licença e tamanho).
# Veja docs/SETUP.md para restaurar.
/Content/PoliceDepartment/
/Content/JOBSITE/
/Content/SUBURBS/
/Content/House_Decor/

# Roupas de MetaHuman baixadas do Fab (WI_/OA_ em /Game/Fab/MetaHuman). Mesma razão: licença.
# Para restaurar, baixe de novo pela biblioteca do Fab ("Add to Project").
/Content/Fab/

# MetaHumans montados (9 presets "MH_<nome>", ~2,4 GB) e o conteudo de MetaHuman novo gerado por eles:
# estourariam a cota de LFS. O projeto esta no OneDrive (copia na nuvem). Para refazer: docs/SETUP.md.
# (o que ja estava versionado em /Content/MetaHumans continua versionado.)
/Content/MetaHumans/
/Content/Library/Characters/Metahumans/MH_Ada/
/Content/Library/Characters/Metahumans/MH_Ada.uasset
/Content/Library/Characters/Metahumans/MH_Aera/
/Content/Library/Characters/Metahumans/MH_Aera.uasset
/Content/Library/Characters/Metahumans/MH_Aoi/
/Content/Library/Characters/Metahumans/MH_Aoi.uasset
/Content/Library/Characters/Metahumans/MH_Asha/
/Content/Library/Characters/Metahumans/MH_Asha.uasset
/Content/Library/Characters/Metahumans/MH_Bo/
/Content/Library/Characters/Metahumans/MH_Bo.uasset
/Content/Library/Characters/Metahumans/MH_Bruce/
/Content/Library/Characters/Metahumans/MH_Bruce.uasset
/Content/Library/Characters/Metahumans/MH_Cameron/
/Content/Library/Characters/Metahumans/MH_Cameron.uasset
/Content/Library/Characters/Metahumans/MH_Celeste/
/Content/Library/Characters/Metahumans/MH_Celeste.uasset
/Content/Library/Characters/Metahumans/MH_Kelvin/
/Content/Library/Characters/Metahumans/MH_Kelvin.uasset
# Monstro das aparições (~200 MB): receita em docs/MONSTER_METAHUMAN.md
/Content/Library/Characters/Metahumans/MH_Monster/
/Content/Library/Characters/Metahumans/MH_Monster.uasset

